# `.env.secrets.example` — placeholder template for the Phase 1 dev `.env.secrets`.
#
# This file is COMMITTED (allow-listed by `.gitignore` via `!.env.secrets.example`).
# The runtime file `.env.secrets` is gitignored — NEVER commit it.
#
# Usage:
#   ./scripts/bootstrap-dev.sh
#   $EDITOR .env.secrets      # replace placeholders with real values
#   secretspec check --profile development
#
# All values below are obvious placeholders (`replace-me-*` shape) — the file's
# only purpose is making `secretspec check --profile development` exit 0 on a
# clean checkout. Real values are out of band (1Password / keyring / sops
# cold-storage per `migration-matrix.md`).

# === AI services ============================================================
NVIDIA_API_KEY=replace-me-nvapi
OPENAI_API_KEY=replace-me-openai
ANTHROPIC_API_KEY=replace-me-anthropic
OPENAI_ORG_ID=replace-me-org-id
HUGGINGFACE_TOKEN=replace-me-hf-token
STABILITY_API_KEY=replace-me-stability
REPLICATE_API_TOKEN=replace-me-replicate

# === CI =====================================================================
GITHUB_TOKEN=replace-me-github-pat
GITHUB_RUNNER_PAT=replace-me-runner-pat
NIX_PACKAGES_CACHE_TOKEN=replace-me-cachix-token

# === Cloud ==================================================================
CLOUDFLARE_TUNNEL_TOKEN=replace-me-cf-tunnel
CLOUDFLARE_API_KEY=replace-me-cf-api-key
CLOUDFLARE_EMAIL=replace-me-email
CLOUDFLARE_ZONE_ID=replace-me-cf-zone-id
TAILSCALE_AUTH_KEY=replace-me-tailscale-key
HOMELAB_DUCKDNS_TOKEN=replace-me-duckdns-token
ACME_ACCOUNT_KEY=replace-me-acme-eab-key

# === Storage ================================================================
GARAGE_ACCESS_KEY=replace-me-garage-access
GARAGE_SECRET_KEY=replace-me-garage-secret
RESTIC_REPO_PASSWORD=replace-me-restic-pass
RCLONE_CONFIG_PASS=replace-me-rclone-pass
BACKUP_ENCRYPTION_KEY=replace-me-age-backup-key

# === Kubernetes =============================================================
K3S_CLUSTER_TOKEN=replace-me-k3s-cluster
KUBECONFIG_ADMIN=replace-me-kubeconfig-admin-base64
KUBEADMIN_PASSWORD=replace-me-kubeadmin-pass
K3S_KUBELET_TOKEN=replace-me-k3s-kubelet

# === Mining =================================================================
# Wallet *keys* deliberately excluded from `keyring://` per
# `sops-provider-design.md` "Wallet key blocklist" — values here are
# placeholders; real wallet keys live in 1Password / sops cold-storage.
# Wallet *addresses* are PUBLIC (mirrored for `sops://` route parity).
ETHEREUM_WALLET_KEY=replace-me-eth-wallet-key
MONERO_WALLET_KEY=replace-me-xmr-wallet-key
ETHEREUM_WALLET_ADDRESS=replace-me-eth-public-address
MONERO_WALLET_ADDRESS=replace-me-xmr-public-address
MINING_POOL_USER=replace-me-mining-user
MINING_POOL_PASS=replace-me-mining-pass

# === Monitoring =============================================================
GRAFANA_ADMIN_PASSWORD=replace-me-grafana-admin
PROMETHEUS_REMOTE_WRITE_TOKEN=replace-me-prom-token
LOKI_INGEST_TOKEN=replace-me-loki-token
UPTIME_ROBOT_API_KEY=replace-me-uptime-robot
GRAFANA_OAUTH_CLIENT_SECRET=replace-me-grafana-oauth

# === Automation =============================================================
N8N_API_KEY=replace-me-n8n-api
N8N_WEBHOOK_SECRET=replace-me-n8n-webhook
ANSIBLE_VAULT_PASSWORD=replace-me-ansible-vault
HOMELAB_RUNNER_REG_TOKEN=replace-me-act-runner-reg

# === Self-hosting ===========================================================
VAULTWARDEN_ADMIN_TOKEN=replace-me-vaultwarden-admin
MAIL_SERVER_PASSWORD=replace-me-mail-server
JELLYFIN_API_KEY=replace-me-jellyfin
PAPERLESS_API_TOKEN=replace-me-paperless
PHOTOPRISM_ADMIN_PASSWORD=replace-me-photoprism
MEALIE_API_KEY=replace-me-mealie
VAULTWARDEN_SMTP_PASSWORD=replace-me-vaultwarden-smtp
NETWORK_WIFI_PASSWORD=replace-me-wifi-psk
